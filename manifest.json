{
  "manifest_version": 3,
  "name": "Read & Pick 读词助手",
  "version": "0.2.0",
  "description": "English-first reading: translate a paragraph only when you need it, and pick words by tier and register.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Read & Pick" },
  "options_page": "options.html"
}
